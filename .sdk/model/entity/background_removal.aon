# Entity: background_removal

main: kit: entity: background_removal: {

  alias: field: {}

  fields: [
    {
      name: "format"
      req: false
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "imageUrl"
      req: false
      short: "URL to download the processed image"
      type: "`$STRING`"
    }
    {
      name: "message"
      req: false
      type: "`$STRING`"
    }
    {
      name: "success"
      req: false
      type: "`$BOOLEAN`"
    }
  ]

  name: "background_removal"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/remove-background"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "remove-background"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
